# ============================================================================
# Flicknest — Local Environment Variables
# ============================================================================
# Copy this file to .env.local and update values as needed.
# Defaults shown are for a freshly started `supabase start` instance.
#
# To get the actual values, run:
#   supabase start
# Then copy the output values into .env.local

# Supabase URL (local API gateway)
NEXT_PUBLIC_SUPABASE_URL=https://lgxcweaxbjbkqufakbpq.supabase.co

# Supabase Anon Key (safe for client-side use)
# Get this from: supabase start output, or Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxneGN3ZWF4Ympia3F1ZmFrYnBxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODExMjQwODUsImV4cCI6MjA5NjcwMDA4NX0.g62cLynzvYVPjtBgWz9S7rtV3mscmmKyAkYAl1KnSqM
# Supabase Service Role Key (server-side only — NEVER expose to the client)
# Get this from: supabase start output, or Supabase dashboard > Settings > API
